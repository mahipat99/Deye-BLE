          "address": "Bluetooth device"
        }
      },
      "bluetooth_confirm": {
        "title": "Set up Deye BLE",
        "description": "Add the Deye logger {name}? Close the Deye app first, because only one Bluetooth client can connect at a time."
      }
    },
    "error": {
      "cannot_connect": "Could not connect to the logger or find its Deye Bluetooth service. Close the Deye app and try again."
    },
    "abort": {
      "already_configured": "This Bluetooth device is already configured."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Deye BLE settings",
        "description": "Choose how the integration uses the Bluetooth link to the logger stick.",
        "data": {
          "connection_mode": "Connection mode",
          "poll_interval": "Polling interval (seconds)",
          "cloud_break": "Cloud upload break (minutes)"
        },
        "data_description": {
          "connection_mode": "Connect on Demand connects for each poll and disconnects afterwards. Always Connected keeps the link open.",
          "poll_interval": "Time between automatic polls, 10 to 300 seconds. While the inverter is asleep, in standby or off, polling slows to every 5 minutes.",
          "cloud_break": "Always Connected mode only. Every this many minutes the Bluetooth link is released for 60 seconds so the logger can send its data to the Deye cloud. 0 turns this off. Not needed in Connect on Demand mode."
        }
      }
    }
